{
    "name": "gmfs-self-order",
    "version": "1.0.0",
    "private": true,
    "description": "Central self-order kiosk for a multi-tenant food court",
    "scripts": {
        "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "cd backend && php artisan serve --host=127.0.0.1 --port=8000",
        "dev:web": "npm --prefix frontend run dev",
        "build": "npm --prefix frontend run build",
        "lint": "npm --prefix frontend run lint",
        "test": "cd backend && php artisan test",
        "db:migrate": "cd backend && php artisan migrate",
        "db:fresh": "cd backend && php artisan migrate:fresh --seed",
        "setup": "npm install && composer --working-dir=backend install && npm --prefix frontend install"
    },
    "devDependencies": {
        "concurrently": "^10.0.3"
    }
}
